QWidget {
    background-color: #f4f6f9;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    color: #2c3e50;
}

QLabel {
    color: #2c3e50;
    font-weight: bold;
}

QPushButton {
    background-color: #616a6b;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1f618d;
}

QSpinBox {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
    font-weight: bold;
}